# MarketLens AI Server Configuration

# Server Port
PORT=3001

# Google Gemini API Key (for zero-setup server-side appraisals)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Configuration (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for MarketLens Pro plans (create in Stripe Dashboard > Products)
STRIPE_PRO_MONTHLY_PRICE_ID=price_monthly_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_annual_...

# Client App / Chrome Extension Return URL (e.g., https://marketlens.ai or Stripe Success page)
CLIENT_SUCCESS_URL=https://marketlens.ai/success?session_id={CHECKOUT_SESSION_ID}
CLIENT_CANCEL_URL=https://marketlens.ai/cancel

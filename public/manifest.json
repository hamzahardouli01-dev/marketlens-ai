{
  "manifest_version": 3,
  "name": "MarketLens AI — Smart Buying Assistant",
  "version": "1.0.0",
  "description": "Should you buy it? AI buy score, fair price check, scam & red-flag detection, photo condition inspection, and negotiation help for any marketplace listing — powered by Google Gemini Vision.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MarketLens AI — Open Appraisal Drawer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/*",
        "https://web.facebook.com/marketplace/*",
        "https://m.facebook.com/marketplace/*",
        "https://*.ebay.com/itm/*",
        "https://*.ebay.ca/itm/*",
        "https://*.craigslist.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://marketlens-backend-nqg2.onrender.com/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://generativelanguage.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
